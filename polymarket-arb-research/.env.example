# Core runtime settings
PM_DB_PATH=./data/processed/polymarket_arb.sqlite3
LOG_LEVEL=INFO

# Polymarket public APIs
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com

# Discovery and recorder tuning
MARKET_REFRESH_SECONDS=300
ORDERBOOK_POLL_SECONDS=1.0
STALE_FEED_SECONDS=15
ORDERBOOK_TOP_LEVELS=5

# BTC reference feed
BTC_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@trade
BTC_SYMBOL=BTCUSDT

# Backtest assumptions (conservative defaults)
FEE_RATE=0.02
SLIPPAGE_BUFFER=0.005
LATENCY_MS=250
MIN_TRADE_SIZE=25
MAX_BOOK_SKEW_MS=300
ONE_LEG_FILL_RISK=0.15
